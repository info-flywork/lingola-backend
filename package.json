{
  "name": "lingola-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Lingola API — Express + MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
